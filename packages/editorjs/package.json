{
  "name": "@assetfeed/editorjs-ai-detector",
  "version": "0.1.1",
  "description": "AI detector for Editor.js. Marks likely AI-written passages beside the text and leaves the saved data untouched.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "editorjs",
    "editor.js",
    "editorjs-plugin",
    "ai-detector",
    "ai-content-detector",
    "ai-text-detector",
    "ai-detection",
    "block-editor",
    "rich-text-editor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assetfeed/ai-detector-plugins.git",
    "directory": "packages/editorjs"
  },
  "homepage": "https://github.com/assetfeed/ai-detector-plugins/tree/main/packages/editorjs#readme",
  "peerDependencies": {
    "@editorjs/editorjs": "^2.0.0"
  },
  "scripts": {
    "build": "esbuild src/index.js --bundle --format=esm --external:@editorjs/editorjs --outfile=dist/index.js && esbuild src/global.js --bundle --format=iife --outfile=dist/aidetector.js",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "@assetfeed/ai-detector-core": "*"
  },
  "bugs": {
    "url": "https://github.com/assetfeed/ai-detector-plugins/issues"
  }
}
